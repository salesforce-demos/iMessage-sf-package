<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Bubble_Style__c</fullName>
    <description>Forces every conversation in this demo blue or green, overriding each conversation&apos;s own Is SMS. Leave blank to let each conversation decide.</description>
    <inlineHelpText>Blank: each conversation uses its own Is SMS. iMessage: everything blue. SMS: everything green.</inlineHelpText>
    <label>Bubble Style</label>
    <required>false</required>
    <trackTrending>false</trackTrending>
    <type>Picklist</type>
    <valueSet>
        <restricted>true</restricted>
        <valueSetDefinition>
            <sorted>false</sorted>
            <value>
                <fullName>iMessage</fullName>
                <default>false</default>
                <label>iMessage — all blue</label>
            </value>
            <value>
                <fullName>SMS</fullName>
                <default>false</default>
                <label>SMS — all green</label>
            </value>
        </valueSetDefinition>
    </valueSet>
</CustomField>
